<h1>Servicios en tiempo real</h1>

<div id="services-container">

  {{#each services}}
    <article>
      <h2>{{name}}</h2>

      <p>Este servicio consta de: {{description}}</p>

      <p>Duración: {{duration}} minutos</p>

      <p class="service-price">
        Precio: ${{price}}
      </p>

      <p>Categoría: {{category}}</p>

      {{#if available}}
        <p class="service-availability available">
          Servicio disponible
        </p>
      {{else}}
        <p class="service-availability unavailable">
          Servicio no disponible
        </p>
      {{/if}}

    </article>
  {{/each}}

</div>
